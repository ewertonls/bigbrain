{{define "workspace"}}
{{template "icons"}}<div class="sheet">
<header class="top"><div class="brand">{{template "brand"}}BigBrain</div><span id="connection" role="status">Connecting…</span><button class="icon-button" data-page="settings" aria-label="Settings" title="Settings"><svg class="icon" aria-hidden="true"><use href="#i-settings"/></svg></button></header>
<div class="scope"><details id="scope-menu"><summary><svg class="icon" aria-hidden="true"><use href="#i-folder"/></svg><strong id="scope-name">Workspace</strong><small id="scope-kind">Scope</small><svg class="icon" aria-hidden="true"><use href="#i-down"/></svg></summary>
<div class="scope-options"><label>Scope <select id="scope"><option value="project">Project</option><option value="global">Global only</option></select></label><label><input type="checkbox" id="global"> Include global</label></div></details></div>
<nav aria-label="Workspace"><button data-page="overview" aria-pressed="true">Overview</button><button data-page="memories">Memories</button><button data-page="graph">Graph</button><button data-page="activity">Activity</button></nav>
<main><div id="notice" role="status">Loading project memory…</div><div id="page"></div></main></div>
{{end}}
{{define "review"}}
<div id="review-message" role="status"></div><div id="drafts"></div>
<div class="actions" id="review-actions"><button id="save-selected" class="primary" disabled>Save selected</button><button id="dismiss-selected" disabled>Dismiss selected</button></div>
{{end}}
{{define "automation"}}
<div id="last-recall"></div><div class="actions"><button id="preview">Preview next context</button><button id="pause">Pause for this session</button></div><pre id="preview-text"></pre><h2>Session policy</h2><div id="policies"></div><p id="hook-state"></p>
{{end}}
{{define "templates"}}<template id="review-template">{{template "review"}}</template><template id="automation-template">{{template "automation"}}</template>{{end}}
